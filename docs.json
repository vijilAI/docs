            ]
          },
          {
            "group": "Red Team",
            "pages": [
              "developer-guide/red-team/overview"
            ]
          },
          {
            "group": "Protect Agents",
            "pages": [
              "developer-guide/protect/overview",
              "developer-guide/protect/installation",
              "developer-guide/protect/control-engine",
