          {
            "group": "Reference",
            "pages": [
              "developer-guide/agentic/tools",
              "developer-guide/reference/controls-api",
              {
                "group": "CLI Reference",
                "pages": [
                  "developer-guide/cli/setup",
                  "developer-guide/cli/discover",
                  "developer-guide/cli/agents",
                  "developer-guide/cli/evaluate",
                  "developer-guide/cli/protect",
                  "developer-guide/cli/red-team",
