            ]
          },
          {
            "group": "Red Team",
            "pages": [
              "owner-guide/red-team/running-campaigns",
              "owner-guide/red-team/understanding-results"
            ]
          },
          {
            "group": "Protect Agents",
            "pages": [
              "owner-guide/protect-in-production/configuring-guardrails",
              "owner-guide/protect-in-production/defend",
              "owner-guide/protect-in-production/deploying-dome",
              "owner-guide/protect-in-production/observability"
            ]
          }
        ]
      },
      {
        "tab": "Agent Developer's Guide",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "developer-guide/getting-started/introduction",
              "developer-guide/getting-started/agent-lifecycle-workflow",
              "developer-guide/agentic/quickstart",
              "developer-guide/deploy-vijil/deploy-vijil-console"
