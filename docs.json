{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Vijil",
  "logo": {
    "dark": "/logo/vijil-logo-dark.svg",
    "light": "/logo/vijil-logo-light.svg"
  },
  "description": "Harden during development, validate before deployment, defend in runtime, and continuously improve agents with reinforcement learning.",
  "colors": {
    "primary": "#DE1616",
    "light": "#FF4444",
    "dark": "#0247A9"
  },
  "css": "/styles.css",
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "api": {
    "openapi": ["openapi/api.json"],
    "playground": {
      "display": "interactive"
    },
    "params": {
      "expanded": "all"
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "python", "javascript", "go"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "redirects": [
    {
      "source": "/get-started/welcome",
      "destination": "/concepts/what-is-vijil"
    },
    {
      "source": "/get-started/quickstart",
      "destination": "/developer-guide/getting-started/quickstart"
    },
    {
      "source": "/get-started/overview",
      "destination": "/owner-guide/getting-started/introduction"
    },
    {
      "source": "/developer-guide/getting-started/api",
      "destination": "/developer-guide/agentic/quickstart"
    },
    {
      "source": "/developer-guide/cli/quickstart",
      "destination": "/developer-guide/agentic/quickstart"
    },
    {
      "source": "/developer-guide/agentic/mcp",
      "destination": "/developer-guide/agentic/quickstart"
    },
    {
      "source": "/owner-guide/register-agents/mcp",
      "destination": "/owner-guide/register-agents/registering-agents"
    },
    {
      "source": "/owner-guide/discover-resources/scanning-resources",
      "destination": "/owner-guide/discover/introduction"
    },
    {
      "source": "/legacy/:slug*",
      "destination": "/concepts/welcome"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Concepts",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "concepts/welcome",
              {
                "group": "Platform",
                "icon": "box",
                "expanded": true,
                "pages": [
                  "concepts/platform/console",
                  "concepts/platform/discover",
                  "concepts/platform/diamond",
                  "concepts/platform/dome",
                  "concepts/platform/darwin"
                ]
              }
            ]
          },
          {
            "group": "Trust Score",
            "pages": [
              "concepts/trust-score/introduction",
              {
                "group": "Dimensions of Trust",
                "icon": "ruler-dimension-line",
                "expanded": true,
                "pages": [
                  "concepts/trust-score/reliability",
                  "concepts/trust-score/safety",
                  "concepts/trust-score/security"
                ]
              }
            ]
          },
          {
            "group": "Discovery",
            "pages": [
              "concepts/discovery/introduction",
              {
                "group": "Discovery Components",
                "icon": "radar",
                "expanded": true,
                "pages": [
                  "concepts/discovery/target",
                  "concepts/discovery/collector",
                  "concepts/discovery/resource",
                  "concepts/discovery/classification"
                ]
              }
            ]
          },
          {
            "group": "Evaluation",
            "pages": [
              "concepts/evaluation-components/introduction",
              {
                "group": "Trust Score Components",
                "icon": "handshake",
                "expanded": true,
                "pages": [
                  "concepts/evaluation-components/harness",
                  "concepts/evaluation-components/scenario",
                  "concepts/evaluation-components/probe",
                  "concepts/evaluation-components/detector"
                ]
              }
            ]
          },
          {
            "group": "Red Team",
            "pages": [
              "concepts/red-team/introduction",
              "concepts/red-team/engagements"
            ]
          },
          {
            "group": "Runtime Defense",
            "pages": [
              "concepts/defense/introduction",
              {
                "group": "Defense Components",
                "icon": "shield-check",
                "expanded": true,
                "pages": [
                  "concepts/defense/guardrail",
                  "concepts/defense/guard",
                  "concepts/defense/detector",
                  "concepts/defense/observe"
                ]
              }
            ]
          },
          {
            "group": "Reference",
            "pages": ["concepts/glossary"]
          }
        ]
