              {
                "group": "API Reference",
                "openapi": "openapi/api.json"
              }
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Diamond",
          "href": "/concepts/platform/diamond",
          "icon": "diamond"
        },
        {
          "anchor": "Blog",
          "href": "https://www.vijil.ai/blog",
          "icon": "newspaper"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@vijil.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Console",
      "href": "https://console.vijil.ai"
    }
  },
  "footer": {
    "socials": {
      "website": "https://vijil.ai",
      "github": "https://github.com/vijilAI/",
      "linkedin": "https://www.linkedin.com/company/vijil"
    }
  },
  "fonts": {
    "family": "Nunito"
  },
  "background": {
    "color": {
      "light": "#f8f8f8"
    },
    "decoration": "gradient"
  },
  "seo": {
    "metatags": {
      "twitter:card": "summary_large_image",
      "twitter:site": "@vijil_ai",
      "og:type": "website",
      "og:site_name": "Vijil",
      "og:image": "https://vijil.ai/og-image.png"
    },
    "indexing": "navigable"
  },
  "metadata": {
    "timestamp": true
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/og/og-docs-default.png",
    "fonts": {
      "family": "Nunito"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "interaction": {
    "drilldown": false
  }
}
